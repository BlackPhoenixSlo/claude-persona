{
  "permissions": {
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Bash(rm -r:*)",
      "Bash(rm -R:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Read(.env*)",
      "Read(**/secrets/**)",
      "Read(~/.ssh/**)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "jq -r '\"agent: \" + (.agent.name // \"default\")'"
  }
}
